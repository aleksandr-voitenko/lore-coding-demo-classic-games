{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    ".githooks/*.mjs",
    "src/app/**/{layout,page,route}.tsx",
    "src/app/**/route.ts",
    "src/**/*.{test,spec}.{ts,tsx}",
    "e2e/**/*.spec.ts",
    "e2e/support/**/*.ts"
  ],
  "project": [
    "*.{js,mjs,ts}",
    ".githooks/**/*.{mjs,ts}",
    "src/**/*.{ts,tsx}",
    "e2e/**/*.ts"
  ],
  "ignoreDependencies": ["shadcn", "tailwindcss", "tw-animate-css"],
  "ignoreBinaries": ["scc"],
  "ignoreExportsUsedInFile": true,
  "ignoreIssues": {
    "src/lib/snake-game-engine.ts": ["duplicates"],
    "src/lib/space-invaders/constants.ts": ["duplicates"]
  }
}
