{
  "name": "lore-coding-demo",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.22.2"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "prepare": "node .githooks/install-lore-coding-hooks.mjs",
    "stats:loc": "scc . --exclude-ext md,json,svg,png,ico --no-gen",
    "check:deps": "depcruise src",
    "check:unused": "knip",
    "build:sidecar": "tsc -p tsconfig.sidecar.json",
    "lint": "eslint",
    "lore-coding": "node .githooks/lore-coding.mjs",
    "start:sidecar": "node dist/sidecar/lib/server/multiplayer-room-sidecar.js",
    "test": "vitest run",
    "test:agent": "vitest run --coverage --reporter=default --reporter=json --reporter=junit --outputFile.json=reports/vitest/results.json --outputFile.junit=reports/vitest/junit.xml",
    "test:coverage": "vitest run --coverage",
    "test:coverage:core": "vitest run --coverage --config vitest.coverage.core.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:install": "playwright install chromium",
    "test:e2e:sidecar": "npm run build:sidecar && playwright test --config e2e/playwright.sidecar.config.ts",
    "test:e2e:ui": "playwright test --ui",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "better-sqlite3": "^12.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.14.0",
    "next": "16.2.4",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "server-only": "^0.0.1",
    "shadcn": "^4.7.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.19.17",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.1.5",
    "babel-plugin-react-compiler": "^1.0.0",
    "dependency-cruiser": "^17.4.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "knip": "^6.16.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.5"
  }
}
